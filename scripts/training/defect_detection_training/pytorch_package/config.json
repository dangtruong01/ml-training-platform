{
  "model_info": {
    "name": "YOLOv8 Defect Detection Model",
    "version": "1.0",
    "type": "object_detection",
    "framework": "YOLOv8",
    "model_size": "s",
    "classes": [
      "dent",
      "dirt",
      "scratch"
    ],
    "num_classes": 3
  },
  "input": {
    "width": 640,
    "height": 640,
    "channels": 3,
    "format": "RGB",
    "normalize": true,
    "mean": [
      0.0,
      0.0,
      0.0
    ],
    "std": [
      255.0,
      255.0,
      255.0
    ]
  },
  "inference": {
    "confidence_threshold": 0.25,
    "iou_threshold": 0.45,
    "max_detections": 300,
    "device": "auto"
  },
  "performance": {
    "map50": 0.31120831672916643,
    "map50_95": 0.13964552291715626
  },
  "postprocessing": {
    "nms_enabled": true,
    "class_agnostic_nms": false
  },
  "preprocessing": {
    "resize_mode": "letterbox",
    "pad_color": [114, 114, 114],
    "keep_aspect_ratio": true,
    "center_pad": true
  },
  "coordinate_system": {
    "output_format": "normalized_to_input",
    "input_size": [640, 640],
    "description": "YOLO outputs coordinates normalized to 640x640 input space, NOT to scaled image dimensions",
    "transformation_notes": [
      "1. YOLO outputs centerX, centerY, width, height in range [0, 640]",
      "2. Remove letterbox padding: adjustedY = centerY - padY",
      "3. Scale to original: originalX = adjustedX / scale_factor",
      "4. Convert center to top-left: x1 = centerX - width/2"
    ]
  }
}